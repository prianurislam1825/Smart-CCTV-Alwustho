# Salin file ini menjadi .env lalu isi dengan nilai sebenarnya.
# Jangan commit file .env atau kredensial kamera ke repository.

# URL RTSP kamera, termasuk username/password yang di-URL-encode.
# Contoh: rtsp://user:password@192.168.1.10:554/stream1
OFFICE_CAMERA_RTSP=""

# Alamat/port kamera VIGI C340 untuk Stream Interface (talk audio).
# Username/password diambil dari URL RTSP di atas (jangan diulang di sini).
VIGI_CAMERA_IP=""
VIGI_RTSP_PORT="554"

# Alamat/akun untuk VIGI OpenAPI (pemantauan; bukan pengiriman audio).
VIGI_OPENAPI_USERNAME=""
VIGI_OPENAPI_PORT=":20443"